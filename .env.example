# Salin ke .env: cp .env.example .env
# Semua variabel yang dibaca aplikasi (cmd/server/main.go) dan goose.

# Database (dipakai aplikasi dan goose CLI)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/go_learn?sslmode=disable
GOOSE_MIGRATION_DIR=./migration

# Secret penanda tangan JWT login user dan cookie sesi admin (wajib). Buat acak: openssl rand -hex 32
JWT_SECRET=

# Port per subcommand: go run ./cmd/server serve-api | serve-admin
API_PORT=3000
ADMIN_PORT=3001

# Dashboard admin (wajib untuk serve-admin). Kunci login POST /admin/login. Buat acak: openssl rand -hex 32
ADMIN_KEY=
# true (default) = cookie hanya dikirim lewat HTTPS. Isi false hanya untuk lokal tanpa HTTPS.
ADMIN_COOKIE_SECURE=false

# Payment gateway
PG_BASE_URL=            # kosong = PG palsu bawaan di http://localhost:3000/fake-pg
PG_PARTNER_ID=
PG_WEBHOOK_SECRET=      # secret HMAC untuk X-SIGNATURE webhook notify
PG_FAKE=true            # true = pasang PG palsu di /fake-pg (hanya untuk lokal)
